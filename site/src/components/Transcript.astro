---
import type { Release } from "../lib/release";

interface Props {
  release: Release;
}

const { release } = Astro.props;
const { version } = release;
const cellar = `/opt/homebrew/Cellar/agentbox/${version}`;

type Line =
  | { kind: "command"; cwd: string; text: string }
  | { kind: "field"; name: string; value: string; note?: "runtime" | "tools" | "state" };

// `agentbox info` on a fresh Homebrew install, field for field as
// libexec/host.sh prints it. Only the release-specific values vary.
const lines: Line[] = [
  { kind: "command", cwd: "~", text: "agentbox info" },
  { kind: "field", name: "Agentbox", value: version },
  { kind: "field", name: "Launcher", value: `${cellar}/bin/agentbox` },
  { kind: "field", name: "Manifest", value: `${cellar}/share/agentbox/release-manifest.json` },
  { kind: "field", name: "Engine", value: "/Applications/Docker.app/Contents/Resources/bin/docker" },
  { kind: "field", name: "State", value: "absent", note: "state" },
  { kind: "field", name: "Runtime", value: release.runtimeImage, note: "runtime" },
  { kind: "field", name: "Claude", value: release.claude.version, note: "tools" },
  { kind: "field", name: "Codex", value: release.codex.version, note: "tools" },
  { kind: "field", name: "Active", value: "none" },
  { kind: "field", name: "Previous", value: "none" },
  { kind: "command", cwd: "~", text: "cd ~/Code/my-project" },
  { kind: "command", cwd: "~/Code/my-project", text: "agentbox claude" },
];
---

<figure class="exhibit" aria-labelledby="exhibit-caption">
  <div class="panel">
    <div class="bar">
      <p id="exhibit-caption">A fresh install, before the first launch</p>
      <button type="button" class="replay" hidden>
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M2.75 8a5.25 5.25 0 1 0 1.6-3.77M2.75 2.5v3.25H6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        Replay
      </button>
    </div>
    <pre class="screen" aria-label="Terminal transcript"><code>{
      lines.map((line, index) =>
        line.kind === "command" ? (
          <span class="line command" style={`--i: ${index}`}><span class="cwd" aria-hidden="true">{line.cwd} $ </span>{line.text}</span>
        ) : (
          <span class="line" style={`--i: ${index}`} data-note={line.note}><span class="key">{line.name}:</span> {line.value}</span>
        ),
      )
    }</code></pre>
    <span class="seal" aria-hidden="true">
      <span class="tag">
        <span class="hole"></span>
        <span>v{version}</span>
      </span>
    </span>
  </div>

  <ul class="notes">
    <li data-note="runtime">
      <strong>Runtime, by digest.</strong> The runtime image is pinned by its OCI index digest. Neither agent is baked
      into it.
    </li>
    <li data-note="tools">
      <strong>Agents, by checksum.</strong> Claude Code and Codex are pinned to exact versions, byte lengths, and SHA-256
      sums, then downloaded straight from Anthropic and OpenAI on first use.
    </li>
    <li data-note="state">
      <strong>Nothing until you launch.</strong> Installing and running <code>info</code> create no
      <code>~/.agentbox</code>, start no container, and download nothing.
    </li>
  </ul>
</figure>

<script>
  for (const exhibit of document.querySelectorAll<HTMLElement>(".exhibit")) {
    const replay = exhibit.querySelector<HTMLButtonElement>(".replay")!;
    const panel = exhibit.querySelector<HTMLElement>(".panel")!;
    if (document.documentElement.dataset.motion !== "ok") continue;
    replay.hidden = false;
    replay.addEventListener("click", () => {
      // Restart the CSS entrance: drop the animation, force a style flush, restore it.
      panel.classList.add("rewind");
      void panel.offsetWidth;
      panel.classList.remove("rewind");
    });
  }
</script>

<style>
  .exhibit {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-6);
  }

  .panel {
    position: relative;
    border: 1px solid var(--term-edge);
    border-radius: var(--radius-lg);
    background: var(--term-bg);
    color: var(--term-fg);
    box-shadow: 0 1px 0 oklch(100% 0 0 / 0.04) inset;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 2.75rem;
    padding: var(--s-2) var(--s-5);
    border-bottom: 1px solid oklch(100% 0 0 / 0.08);
    color: var(--term-dim);
    font-size: 0.8125rem;
    font-weight: 560;
  }

  .replay {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-1) var(--s-2);
    margin-right: calc(-1 * var(--s-2));
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--term-dim);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: color 150ms var(--ease-out), background-color 150ms var(--ease-out);
  }

  .replay:hover {
    color: var(--term-fg);
    background: oklch(100% 0 0 / 0.07);
  }

  .screen {
    padding: var(--s-5);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 0.8125rem;
    line-height: 1.75;
  }

  .line {
    display: block;
    margin-inline: calc(-1 * var(--s-2));
    padding-inline: var(--s-2);
    border-radius: 0.25rem;
    transition: background-color 200ms var(--ease-out);
  }

  .command:not(:first-child) {
    margin-top: var(--s-3);
  }

  .cwd {
    color: var(--term-prompt);
    user-select: none;
  }

  .key {
    color: var(--term-key);
  }

  /* Pointing at a note lights up the lines it explains; the notes name them too. */
  .exhibit:has(li[data-note="runtime"]:hover) .line[data-note="runtime"],
  .exhibit:has(li[data-note="tools"]:hover) .line[data-note="tools"],
  .exhibit:has(li[data-note="state"]:hover) .line[data-note="state"] {
    background: var(--term-mark);
  }

  /* A container seal: the tag carries the release it closes. */
  .seal {
    position: absolute;
    bottom: -0.625rem;
    right: var(--s-5);
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-1) var(--s-3) var(--s-1) var(--s-2);
    border-radius: 0.3rem 0.3rem 0.3rem 0.3rem;
    background: var(--signal);
    color: var(--on-signal);
    font-family: var(--font-mono);
    font-stretch: 87.5%;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.5;
    rotate: 2deg;
    transform-origin: 0.75rem 50%;
    box-shadow: 0 2px 0 oklch(30% 0.08 40 / 0.35);
  }

  /* Nudge the tag and it swings on its hole, then settles. */
  @keyframes swing {
    25% {
      rotate: -5deg;
    }
    50% {
      rotate: 4deg;
    }
    75% {
      rotate: 0.5deg;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .tag:hover {
      animation: swing 900ms var(--ease-out);
    }
  }

  .hole {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--term-bg);
    box-shadow: 0 0 0 1.5px oklch(30% 0.08 40 / 0.45);
  }

  .notes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--s-5);
    padding: 0;
    list-style: none;
    font-size: 0.90625rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .notes li {
    padding-top: var(--s-3);
    border-top: 2px solid var(--rule);
    transition: border-color 200ms var(--ease-out);
  }

  .notes li:hover {
    border-top-color: var(--signal);
  }

  .notes strong {
    display: block;
    margin-bottom: var(--s-1);
    color: var(--ink);
    font-weight: 700;
  }

  /* The one authored entrance: lines arrive in order, once. */
  @keyframes arrive {
    from {
      opacity: 0;
      translate: -0.375rem 0;
    }
  }

  @keyframes seal {
    from {
      opacity: 0;
      translate: 0 0.75rem;
      rotate: -8deg;
    }
  }

  :global(html[data-motion="ok"]) .line {
    animation: arrive 420ms var(--ease-out) both;
    animation-delay: calc(320ms + var(--i) * 55ms);
  }

  :global(html[data-motion="ok"]) .command:not(:first-child) {
    animation-delay: calc(520ms + var(--i) * 55ms);
  }

  :global(html[data-motion="ok"]) .seal {
    animation: seal 640ms var(--ease-out) both;
    animation-delay: 1300ms;
  }

  .rewind :is(.line, .seal) {
    animation: none !important;
  }
</style>
