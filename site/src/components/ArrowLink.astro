---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a class="arrow-link" href={href}>
  <slot />
  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
    <path d="M2.75 8h10m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</a>

<style>
  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375em;
  }

  svg {
    flex: none;
    color: var(--signal-ink);
    transition: translate 200ms var(--ease-out);
  }

  .arrow-link:hover svg {
    translate: 0.1875rem 0;
  }
</style>
