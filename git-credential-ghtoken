#!/bin/sh
# git credential helper: serve the GH_TOKEN env var (injected at `docker run`)
# as the GitHub HTTPS password — but ONLY for github.com. It is registered
# system-wide, so git calls it for every HTTPS auth challenge; without host
# scoping a non-GitHub remote (a submodule, an HTTP redirect, a typosquatted
# host) could harvest the live token. git passes the request as key=value lines
# on stdin (protocol=, host=, ...), terminated by a blank line — we read them
# and only hand over the token when the host is GitHub.
[ "$1" = "get" ] || exit 0
[ -n "$GH_TOKEN" ] || exit 0

proto=""
host=""
while IFS='=' read -r key value; do
  case "$key" in
    protocol) proto="$value" ;;
    host) host="$value" ;;
    "") break ;;  # blank line terminates the request
  esac
done

[ "$proto" = "https" ] || exit 0
case "$host" in
  github.com | *.github.com) ;;
  *) exit 0 ;;
esac

echo "username=x-access-token"
echo "password=$GH_TOKEN"
