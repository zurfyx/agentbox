#!/bin/sh
# git credential helper: serve the GH_TOKEN env var (injected at `docker run`)
# as the GitHub HTTPS password. Lets git inside the container authenticate with
# the host's live `gh auth token` — no Mac binary, no keychain, no on-disk secret.
[ "$1" = "get" ] || exit 0
[ -n "$GH_TOKEN" ] || exit 0
echo "username=x-access-token"
echo "password=$GH_TOKEN"
