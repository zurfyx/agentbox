#!/bin/sh
# onhost — run a command on the macOS host from inside the container.
#
#   onhost '<shell string>'   run a ready-to-run shell string on the host
#   onhost <cmd> <arg>...     run argv-style; each arg's quoting is preserved
#   onhost -t ...             allocate a real TTY (Darwin pty) for interactive
#                             tools and pty-behavior tests
#
# Why: a Linux container can't exec macOS-only binaries or reproduce Darwin
# kernel/pty behavior. This hops to the host over SSH so the container can drive
# host-only steps (smoke tests, pty tests) without you switching terminals.
#
# Requires: Remote Login enabled on the Mac + the dedicated key installed by
# setup-host-bridge.sh. Host/user are injected by the launcher via
# AGENTBOX_HOST / AGENTBOX_HOST_USER (defaults: host.docker.internal / Mac user).
set -eu

KEY="$HOME/.ssh/id_agentbox_host"
HOST="${AGENTBOX_HOST:-host.docker.internal}"
HOST_USER="${AGENTBOX_HOST_USER:-}"

if [ ! -f "$KEY" ]; then
  echo "onhost: missing key $KEY — run setup-host-bridge.sh on the Mac first" >&2
  exit 1
fi
if [ -z "$HOST_USER" ]; then
  echo "onhost: AGENTBOX_HOST_USER is not set (the launcher injects it; or export it)" >&2
  exit 1
fi

TTY_FLAG=""
if [ "${1:-}" = "-t" ]; then TTY_FLAG="-tt"; shift; fi

[ "$#" -ge 1 ] || { echo "onhost: no command given" >&2; exit 2; }

# ssh joins its command args with spaces and runs them via the remote shell.
# A single arg is passed through as a shell string (like `ssh host 'cmd'`).
# For argv-style calls (>1 arg), re-quote each arg so spaces/globs survive.
if [ "$#" -gt 1 ]; then
  q=""
  for a in "$@"; do
    esc=$(printf '%s' "$a" | sed "s/'/'\\\\''/g")
    q="$q '$esc'"
  done
  set -- "$q"
fi

exec ssh $TTY_FLAG \
  -i "$KEY" \
  -o IdentitiesOnly=yes \
  -o StrictHostKeyChecking=accept-new \
  -o UserKnownHostsFile="$HOME/.ssh/known_hosts" \
  "$HOST_USER@$HOST" "$@"
